{
  "version": "0.2.0",
  "configurations": [
    // Attach-only by design: a browser `request:launch` config lets js-debug spawn the browser, which
    // hands off to any already-running instance (its port never binds -> "Unable to attach to
    // browser") and gates every new target on the debugger, freezing service-worker-opened tabs.
    // The preLaunchTask launches the browser itself and does not return until the CDP port answers.
    {
      "name": "Run/Debug Extension (Edge)",
      "type": "msedge",
      "request": "attach",
      "port": 9222,
      "webRoot": "${workspaceFolder}/dist",
      "timeout": 30000,
      "preLaunchTask": "Run: Extension (Edge, no debugger)"
    },
    {
      "name": "Run/Debug Extension (Chrome for Testing)",
      "type": "chrome",
      "request": "attach",
      "port": 9223,
      "webRoot": "${workspaceFolder}/dist",
      "timeout": 30000,
      "preLaunchTask": "Run: Extension (Chrome for Testing, no debugger)"
    }
  ]
}
